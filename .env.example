# BookFlow configuration — copy to your environment and adjust.
# All values are optional; defaults are shown. See README.md.

# Bind address and port for the HTTP server.
OPDS_HOST=0.0.0.0
OPDS_PORT=8000

# Data directory: SQLite database and the optimization cache live here.
# Must be writable. The library folders themselves are never written to.
OPDS_DATA_DIR=./data

# Override the SQLAlchemy database URL (defaults to SQLite inside DATA_DIR).
# OPDS_DATABASE_URL=sqlite+pysqlite:///./data/bookflow.db

# Flask session secret. Leave empty: a random secret is generated on first
# start and persisted to data/.session_secret (0600), shared by all workers
# and kept across restarts. Set a fixed value only if you manage sessions
# yourself (e.g. several instances sharing one data directory).
OPDS_SESSION_SECRET=

# Single admin user, used for both the admin UI (login form) and OPDS
# (HTTP Basic Auth). Leave the password empty to disable the catalog.
OPDS_ADMIN_USERNAME=admin
OPDS_ADMIN_PASSWORD=

# Set to true when serving over HTTPS so the session cookie gets Secure.
OPDS_SESSION_COOKIE_SECURE=false

# Comma-separated file extensions indexed by the scanner.
OPDS_SCAN_EXTENSIONS=.epub,.pdf,.cbz,.cbr,.mobi,.azw3

# --- docker compose (read by docker-compose.yml for ${...} interpolation) ---
# Host bind address/port for the container (defaults shown).
# BOOKFLOW_BIND=127.0.0.1
# BOOKFLOW_PORT=8000
# Host path of the library, mounted read-only at /library inside the container.
# LIBRARY_DIR=./library
# GUNICORN_WORKERS=2
