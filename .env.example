# BookFlow configuration — all values are optional and have defaults.
# For bare metal: export these in your environment (or copy this file to
# `.env` and load it before starting the server).
# For docker compose: set them in docker-compose.yml's `environment` block —
# compose does not read `.env` for the container any more.
# See README.md for the full description of every setting.

# --- app settings ------------------------------------------------------------

# Bind address and port (bare metal; the container always listens on 8000).
OPDS_HOST=0.0.0.0
OPDS_PORT=8000

# Data directory: SQLite database, optimization cache and the generated
# session secret live here. Must be writable. Library folders are never
# written to. Relative paths resolve against the working directory — in the
# container that is /app, so the default ./data lands in the named volume.
OPDS_DATA_DIR=./data

# Single admin user, used for both the admin UI (login form) and OPDS
# (HTTP Basic Auth). OPDS is disabled (503) and admin login is locked until
# you set a password here.
OPDS_ADMIN_USERNAME=admin
OPDS_ADMIN_PASSWORD=

# Leave empty: a random secret is generated on first start and persisted to
# data/.session_secret (0600), shared by all workers and kept across
# restarts. Set a fixed value only if you manage sessions yourself.
OPDS_SESSION_SECRET=

# Set to true when serving over HTTPS so the session cookie gets Secure.
OPDS_SESSION_COOKIE_SECURE=false

# Comma-separated file extensions indexed by the scanner.
OPDS_SCAN_EXTENSIONS=.epub,.pdf,.cbz,.cbr,.mobi,.azw3

# Root the admin folder browser (Folders -> Add Folder -> Browse...) is
# clamped to. Only affects browsing; typed paths stay unrestricted.
OPDS_BROWSE_ROOT=/

# --- docker compose ------------------------------------------------------------
# Compose has no interpolation step: edit docker-compose.yml directly.
#   ports:     - "127.0.0.1:8000:8000"   host bind address and port
#   volumes:   - ./library:/library:ro   host library path, mounted read-only
#   environment: OPDS_ADMIN_PASSWORD     the one setting to set before start
#                # GUNICORN_WORKERS: "2"  commented out = app default
